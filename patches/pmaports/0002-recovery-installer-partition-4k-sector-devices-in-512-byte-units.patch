From: ahmedsaed <ahmedsaed2652003@gmail.com>
Subject: [PATCH] postmarketos-android-recovery-installer: partition 4K-sector
 devices in 512-byte units

On storage with 4096-byte logical sectors (Samsung A51 UFS), parted on the
install partition writes the subpartition MBR in 4K units. The initramfs
maps subpartitions with "losetup -P", which reads them in 512-byte units,
and the downstream 4.14 kernel ignores "losetup --sector-size". Result:
"ERROR: failed to mount subpartitions!".

Partition through a 512-byte loop device instead, so the table is written
in 512-byte units (same byte offsets) and kpartx maps it the same way.

Base: pmaports 78e02f370c4e90f53e11fc3d728e3c67fdbaeab6
---
diff --git a/main/postmarketos-android-recovery-installer/0001-partition-4k-sector-devices-in-512-byte-units.patch b/main/postmarketos-android-recovery-installer/0001-partition-4k-sector-devices-in-512-byte-units.patch
new file mode 100644
index 0000000000..3d008fb00f
--- /dev/null
+++ b/main/postmarketos-android-recovery-installer/0001-partition-4k-sector-devices-in-512-byte-units.patch
@@ -0,0 +1,45 @@
+--- a/pmos_install_functions
++++ b/pmos_install_functions
+@@ -80,23 +80,37 @@
+ }
+ 
+ partition_install_device() {
++	# The initramfs maps these subpartitions with "losetup -P", which reads
++	# the table in 512-byte units. On storage with bigger logical sectors
++	# (e.g. 4K UFS), write the table through a 512-byte loop device so the
++	# units match. Some downstream kernels can't change the loop sector size.
++	local table_device="$INSTALL_DEVICE"
++	if [ "$INSTALL_PARTITION" != "external_sd" ] &&
++		[ "$(blockdev --getss "$INSTALL_DEVICE")" != "512" ]; then
++		table_device="$(losetup -f)"
++		losetup "$table_device" "$INSTALL_DEVICE"
++		echo "$INSTALL_DEVICE has $(blockdev --getss "$INSTALL_DEVICE")-byte" \
++			"sectors, partitioning it through $table_device"
++	fi
+ 	for command in "mktable msdos" \
+ 		"mkpart primary ext2 2048s 256M" \
+ 		"mkpart primary 256M 100%" \
+ 		"set 1 boot on"
+ 	do
+-		parted -s "$INSTALL_DEVICE" "$command"
++		parted -s "$table_device" "$command"
+ 	done
+ 	partprobe
+ 	if [ "$INSTALL_PARTITION" != "external_sd" ]; then
+-		kpartx -afs "$INSTALL_DEVICE"
++		kpartx -afs "$table_device"
+ 	fi
+-	set_subpartitions
++	set_subpartitions "$table_device"
+ }
+ 
++# $1: device holding the partition table (default: $INSTALL_DEVICE)
+ set_subpartitions() {
++	local table_device="${1:-$INSTALL_DEVICE}"
+ 	export PMOS_BOOT
+-	PMOS_BOOT=/dev/mapper/"$(basename "$INSTALL_DEVICE")"p1
++	PMOS_BOOT=/dev/mapper/"$(basename "$table_device")"p1
+ 	export ROOT_PARTITION
+-	ROOT_PARTITION=/dev/mapper/"$(basename "$INSTALL_DEVICE")"p2
++	ROOT_PARTITION=/dev/mapper/"$(basename "$table_device")"p2
+ }
diff --git a/main/postmarketos-android-recovery-installer/APKBUILD b/main/postmarketos-android-recovery-installer/APKBUILD
index 63ea075d8f..d5de0537cd 100644
--- a/main/postmarketos-android-recovery-installer/APKBUILD
+++ b/main/postmarketos-android-recovery-installer/APKBUILD
@@ -1,14 +1,16 @@
 maintainer="Oliver Smith <ollieparanoid@postmarketos.org>"
 pkgname=postmarketos-android-recovery-installer
 pkgver=1.0.7
-pkgrel=1
+pkgrel=2
 pkgdesc="TWRP compatible postmarketOS installer script"
 arch="all"
 url="https://postmarketos.org"
 license="GPL-3.0-or-later"
 # multipath-tools: kpartx
 depends="busybox-extras lddtree cryptsetup multipath-tools device-mapper parted util-linux zip e2fsprogs tar"
-source="https://gitlab.com/postmarketos/postmarketos-android-recovery-installer/-/archive/$pkgver/postmarketos-android-recovery-installer-$pkgver.tar.gz"
+source="https://gitlab.com/postmarketos/postmarketos-android-recovery-installer/-/archive/$pkgver/postmarketos-android-recovery-installer-$pkgver.tar.gz
+	0001-partition-4k-sector-devices-in-512-byte-units.patch
+	"
 options="!check" # No tests
 
 build() {
@@ -31,4 +33,5 @@ package() {
 }
 sha512sums="
 22481d26d78388eb67278a1ddd699abc3ca1c5df3c9f1d386d3fb95076e50d9209c8388d5700a6da5e476ac96023d55624c27b427767ee65775c24369dc11313  postmarketos-android-recovery-installer-1.0.7.tar.gz
+dee9ca00b73b5973139fdda8cc1132e57bbbdb4f601c34ecc0d264ed93a0f0aa6652f4d08cf8a575745dbbc6b916177fbdfd7802f843aba81450e1240b93a89f  0001-partition-4k-sector-devices-in-512-byte-units.patch
